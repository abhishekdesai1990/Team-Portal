{
  "name": "team-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:TeamPortal": "node dist/TeamPortal/server/server.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:video": "cypress run --config video=true",
    "cypress:run:no-video": "cypress run --config video=false",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:video": "cypress run --config video=true,videoCompression=32",
    "e2e:record": "cypress run --record --config video=true"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "^20.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "cypress": "^13.17.0",
    "typescript": "~5.8.2"
  }
}
